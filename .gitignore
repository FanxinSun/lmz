lmz/gpu/lmzgpu-*.dylib
lmz/gpu/lmzgpu-*.dll

# Built by hand from scratchpad/ when a coder question comes up.
coderbench
encbench
encbench-neon

*.lmz
build/
dist/
*.egg-info/

# Terminal session transcripts. One was committed by accident in bd3fb42;
# they are not part of the package and say nothing about the code.
log.txt

